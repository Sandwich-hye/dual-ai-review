{
  "name": "dual-ai-review",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser foundation for dual AI review",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "smoke:chatgpt": "npm run build && node dist/scripts/smoke-chatgpt.js",
    "smoke:claude": "npm run build && node dist/scripts/smoke-claude.js",
    "smoke:claude-long-prompt": "npm run build && node dist/scripts/smoke-claude-long-prompt.js",
    "inspect:claude": "npm run build && node dist/scripts/inspect-claude-dom.js",
    "inspect:claude-composer": "npm run build && node dist/scripts/inspect-claude-composer.js",
    "inspect:claude-pages": "npm run build && node dist/scripts/inspect-claude-pages.js",
    "inspect:claude-submission": "npm run build && node dist/scripts/inspect-claude-submission.js",
    "inspect:claude-message-roles": "npm run build && node dist/scripts/inspect-claude-message-roles.js",
    "test:claude-submit": "npm run build && node dist/scripts/test-claude-submit.js",
    "smoke:single-round": "npm run build && node dist/scripts/smoke-single-round.js",
    "test": "playwright test"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}






